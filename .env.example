# Budgets sit under the Gemini free-tier limits (15 requests/min, 500/day,
# 250K tokens/min), so a trial key is never exhausted or throttled. They are
# shared by all visitors together. Raise them only on a paid key.
AI_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

AI_TEMPERATURE=0
AI_TIMEOUT_MS=30000
AI_MAX_PROMPT_CHARS=16000
AI_MAX_OUTPUT_TOKENS=4500
AI_CACHE_MINUTES=60

AI_BUDGET_PER_MINUTE=10
AI_BUDGET_PER_DAY=400

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

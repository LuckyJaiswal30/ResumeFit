AI_PROVIDER=gemini

# gemini-3.5-flash-lite free tier, confirmed in AI Studio:
# 15 requests/minute, 500 requests/day, 250K tokens/minute.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# openai/gpt-oss-20b free tier, per Groq's published limits:
# 30 requests/minute, 1K requests/day, 8K tokens/minute, 200K tokens/day.
# Tokens run out long before requests do: one review costs roughly 4,850,
# which is about 40 reviews a day.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

AI_TEMPERATURE=0
AI_TIMEOUT_MS=30000
AI_MAX_PROMPT_CHARS=
AI_MAX_OUTPUT_TOKENS=
AI_CACHE_MINUTES=60

# Shared ceiling across every visitor, not per person. Defaults sit under
# the free tier figures above: 10/minute and 400/day for Gemini, 2/minute
# and 35/day for Groq. Raise these on a paid key.
AI_BUDGET_PER_MINUTE=
AI_BUDGET_PER_DAY=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
